# Обычный конфиг WireGuard. Скопируй в vpnsplit.conf и подставь свои значения.
# vpnsplit.conf в git не попадает (см. .gitignore).

[Interface]
PrivateKey = <приватный ключ клиента, base64>
Address = 10.8.0.2/32
# Если сервер даёт IPv6 — добавь второй адрес через запятую, иначе v6 потечёт
# мимо туннеля:
# Address = 10.8.0.2/32, fd00::2/128
DNS = 1.1.1.1
MTU = 1420

[Peer]
PublicKey = <публичный ключ сервера, base64>
# PresharedKey = <необязательно>
AllowedIPs = 0.0.0.0/0, ::/0
Endpoint = server.example.com:51820
PersistentKeepalive = 25
